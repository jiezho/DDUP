    "steps_to_add_instance": [
      "1. 在 instances[] 数组中追加新实例的 JSON 条目",
      "2. 创建 agents/{instance-id}/ 私有目录（含 SOUL.md）",
      "3. shared-library/outputs/{instance-id}/ 按需创建",
      "4. shared-library/memory-ext/{instance-id}/ 按需创建",
      "5. shared-library/wiki/_raw/{instance-id}/ 按需创建",
      "6. 在实例本地安装 shared-library-client 技能",
      "7. 执行注册验证：hermes run 'verify shared-library access'"
